---
// Vista «San Juan»: el portfolio en el Valle de la Luna (Ischigualasto), de noche
// y con luna llena. El Hongo, El Submarino, la Cancha de Bochas y un viento Zonda
// que mueve todo: estratos que se corren, etiquetas de campo que se hamacan,
// polvo y tecnologías que ruedan como bochas (scripts/zonda.ts, matter-js).
// Contenido de perfil.ts (vía i18n).
import ViewLayout from "@/layouts/ViewLayout.astro";
import MensajeForm from "@/components/MensajeForm.astro";
import Indice from "@/components/Indice.astro";
import { habilidades } from "@/data/perfil";
import { contenido, periodoL, ruta, t, type Lang } from "@/data/i18n";
import { casos } from "@/data/casos";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const { perfil, experiencia, proyectos, estudios, AREAS } = contenido(lang);
const base = import.meta.env.BASE_URL;
const conCaso = new Set(casos.map((c) => c.id));
const [nombre, apellido] = perfil.nombre.split(" ");
const secciones = [
  { id: "sj-cielo", nombre: t(lang, "El valle", "The valley") },
  { id: "sj-quien", nombre: t(lang, "Quién soy", "About") },
  { id: "sj-experiencia", nombre: t(lang, "Estratos", "Strata") },
  { id: "sj-proyectos", nombre: t(lang, "Hallazgos", "Finds") },
  { id: "sj-stack", nombre: t(lang, "Cancha de bochas", "Bocce field") },
  { id: "sj-contacto", nombre: t(lang, "Contacto", "Contact") },
];
const n = (i: number) => String(i).padStart(2, "0");
// Estratos: de arriba (lo más nuevo) hacia abajo, cada uno con su color de roca.
const CAPAS = ["#c98a5a", "#b7643f", "#d8cdb8", "#8d4a3a", "#a89a86"];
// Diámetro de cada bocha según el largo del nombre.
const diam = (s: string) => Math.round(Math.min(150, Math.max(72, 30 + s.length * 9.5)));
// Estrellas fijas (posición pseudoaleatoria estable entre builds).
const estrellas = Array.from({ length: 70 }, (_, i) => ({
  x: (i * 37.7) % 100,
  y: ((i * 53.3) % 55) + 1,
  r: i % 7 === 0 ? 1.6 : i % 3 === 0 ? 1.1 : 0.7,
  d: (i % 5) * 0.7,
}));
---

<ViewLayout
  title={t(lang, "Ignacio Colomé · Valle de la Luna", "Ignacio Colomé · Valley of the Moon")}
  description={t(
    lang,
    "El portfolio de Ignacio Colomé en el Valle de la Luna, San Juan: estratos, hallazgos, bochas y un viento Zonda que mueve todo.",
    "Ignacio Colomé's portfolio in the Valley of the Moon, San Juan: strata, finds, bocce stones and a Zonda wind that blows everything around.",
  )}
  vista="sanjuan"
  lang={lang}
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,600;12..96,800&family=IBM+Plex+Mono:wght@500&display=swap"
      rel="stylesheet"
    />
  </Fragment>

  <div class="sj" data-sj data-lang={lang}>
    <canvas class="sj-polvo" data-polvo aria-hidden="true"></canvas>
    <Indice secciones={secciones} label={t(lang, "Secciones", "Sections")} />

    <section id="sj-cielo" class="sj-hero">
      <div class="sj-cielo" aria-hidden="true">
        <svg class="sj-estrellas" viewBox="0 0 100 60" preserveAspectRatio="none">
          {estrellas.map((e) => <circle cx={e.x} cy={e.y} r={e.r * 0.12} style={`animation-delay:${e.d}s`} />)}
        </svg>
        <span class="sj-luna"></span>
        <!-- Barrancas del fondo: los paredones rojos de Los Colorados -->
        <svg class="sj-capa sj-capa-3" viewBox="0 0 1440 400" preserveAspectRatio="none">
          <path d="M0 400V170h120l30-20h160l20 18h200l40-30h210l20 22h180l30-16h210l30 20h190v236Z" />
          <path class="sj-veta" d="M0 230h1440M0 262h1440M0 300h1440" />
        </svg>
        <!-- Lomas de arcilla gris («paisaje lunar») -->
        <svg class="sj-capa sj-capa-2" viewBox="0 0 1440 400" preserveAspectRatio="none">
          <path d="M0 400V280c60-30 110-34 170-12s120 20 180-6 140-30 210 0 120 26 190 2 150-28 220 4 130 22 190 0 90-16 130-6v138Z" />
        </svg>
        <!-- El Submarino (izquierda) y El Hongo (derecha) -->
        <svg class="sj-forma sj-submarino" viewBox="0 0 220 260">
          <path d="M18 260 30 150c6-30 18-42 34-46l10-58c2-12 10-18 22-18h20c10 0 16 8 16 18l4 58c22 6 40 22 46 54l10 102Z" />
          <path class="sj-veta" d="M26 200h168M24 228h172" />
        </svg>
        <svg class="sj-forma sj-hongo" viewBox="0 0 200 240">
          <path d="M14 70c0-30 40-50 86-50s86 20 86 50c0 16-18 24-40 24h-24c-6 0-10 4-11 10l-6 116c0 8 4 14 10 20H85c6-6 10-12 10-20l-6-116c-1-6-5-10-11-10H54c-22 0-40-8-40-24Z" />
          <path d="M60 240h80" />
        </svg>
        <!-- Suelo con la Cancha de Bochas -->
        <svg class="sj-suelo" viewBox="0 0 1440 220" preserveAspectRatio="none">
          <path d="M0 220V70c180-26 360-30 560-20s420 26 600 12 220-14 280-10v168Z" />
        </svg>
        <svg class="sj-bochas" viewBox="0 0 1440 220" preserveAspectRatio="xMidYMax slice">
          {
            [
              [180, 150, 26], [260, 170, 18], [330, 140, 14], [470, 182, 30], [560, 158, 12],
              [880, 176, 22], [960, 150, 16], [1050, 188, 34], [1180, 160, 20], [1260, 178, 14],
            ].map(([x, y, r]) => (
              <g>
                <ellipse cx={x} cy={y + r * 0.9} rx={r * 1.15} ry={r * 0.22} class="sj-sombra" />
                <circle cx={x} cy={y} r={r} />
              </g>
            ))
          }
        </svg>
        <span class="sj-bruma"></span>
      </div>

      <div class="sj-hero-in">
        <p class="sj-k">Ischigualasto · {t(lang, "Valle de la Luna", "Valley of the Moon")} · San Juan</p>
        <h1 aria-label={perfil.nombre}>
          <span class="sj-linea" aria-hidden="true">{[...nombre].map((c) => <span data-letra>{c}</span>)}</span>
          <span class="sj-linea" aria-hidden="true">{[...apellido].map((c) => <span data-letra>{c}</span>)}</span>
        </h1>
        <p class="sj-bajada">
          {t(
            lang,
            "Analista de datos y desarrollador web, de San Juan. Como en Ischigualasto, cada capa cuenta algo: la formación abajo, el trabajo arriba y los proyectos como hallazgos.",
            "Data analyst and web developer from San Juan. Like in Ischigualasto, every layer tells something: education at the bottom, work on top and projects as finds.",
          )}
        </p>
        <div class="sj-clima" aria-live="off">
          <span>{t(lang, "Viento", "Wind")}: <b data-viento>{t(lang, "calma", "calm")}</b></span>
          <span><b data-vel>6</b> km/h</span>
          <span><b data-temp>24</b> °C</span>
          <span>{t(lang, "Luna llena", "Full moon")}</span>
        </div>
        <button type="button" class="sj-btn" data-zonda aria-pressed="false">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M3 8h11a3 3 0 1 0-3-3M3 12h16a3 3 0 1 1-3 3M3 16h8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
          <span class="sj-btn-on">{t(lang, "Soplar el Zonda", "Blow the Zonda")}</span>
          <span class="sj-btn-off">{t(lang, "Calmar el viento", "Calm the wind")}</span>
        </button>
      </div>
    </section>

    <main class="sj-tierra">
      <section id="sj-quien" class="sj-sec sj-quien">
        <figure class="sj-polaroid" data-hamaca="1.4">
          <span class="sj-clip" aria-hidden="true"></span>
          <img src={`${base}foto_perfil_recorte.jpg`} alt={perfil.nombre} loading="lazy" />
          <figcaption>{perfil.alias} · {perfil.ubicacion}</figcaption>
        </figure>
        <div>
          <p class="sj-k">{n(1)} · {t(lang, "Quién soy", "About")}</p>
          <h2>{t(lang, "Datos de día, web de noche", "Data by day, web by night")}</h2>
          <p class="sj-p">
            {t(
              lang,
              "En Datyo mantengo un warehouse en SQL Server, migro sus transformaciones a dbt con tests y linaje y armo tableros en Power BI. Por fuera, diseño y programo sitios con Astro donde la interacción es parte del contenido.",
              "At Datyo I maintain a SQL Server warehouse, migrate its transformations to dbt with tests and lineage and build Power BI dashboards. On the side, I design and code Astro sites where interaction is part of the content.",
            )}
          </p>
          <p class="sj-badge"><i></i>{perfil.disponibilidad}</p>
        </div>
      </section>

      <section id="sj-experiencia" class="sj-sec">
        <p class="sj-k">{n(2)} · {t(lang, "Experiencia", "Experience")}</p>
        <h2>{t(lang, "Estratos", "Strata")}</h2>
        <p class="sj-p sj-nota">
          {t(
            lang,
            "Como en las barrancas del valle, se lee de abajo hacia arriba: cada puesto es una capa y la más nueva está arriba.",
            "Like the valley's cliffs, it reads from the bottom up: each job is a layer and the newest is on top.",
          )}
        </p>
        <ol class="sj-estratos">
          {
            experiencia.map((e, i) => (
              <li class={`sj-estrato sj-${e.area}`} style={`--capa:${CAPAS[i % CAPAS.length]}`} data-deriva={String(1 - i * 0.18)}>
                <p class="sj-fecha">{periodoL(lang, e.desde, e.hasta)}</p>
                <div>
                  <h3>
                    {e.empresa} <span>· {e.rol}</span>
                  </h3>
                  <p class="sj-desc">{e.descripcion}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </section>

      <section id="sj-proyectos" class="sj-sec">
        <p class="sj-k">{n(3)} · {t(lang, "Proyectos", "Projects")}</p>
        <h2>{t(lang, "Hallazgos", "Finds")}</h2>
        <p class="sj-p sj-nota">
          {t(lang, "Cada uno con su etiqueta de campo, colgada de la cuadrícula de excavación.", "Each with its field tag, hanging from the excavation grid.")}
        </p>
        <div class="sj-grilla">
          <span class="sj-cuerda" aria-hidden="true"></span>
          <div class="sj-proy">
            {
              proyectos.map((p, i) => (
                <article class="sj-hallazgo" data-hamaca={String(2.4 + i * 0.3)}>
                  <span class="sj-clip" aria-hidden="true" />
                  <p class="sj-etiqueta">
                    {t(lang, "Hallazgo", "Find")} n.º {String(i + 1).padStart(3, "0")} · {AREAS[p.area]} · {p.anio}
                  </p>
                  {p.imagen && <img src={`${base}${p.imagen}`} alt="" loading="lazy" />}
                  <div class="sj-hallazgo-body">
                    <h3>{p.titulo}</h3>
                    <p class="sj-desc">{p.descripcion}</p>
                    <p class="sj-links">
                      {conCaso.has(p.id) && <a href={ruta(lang, `casos/${p.id}/`)}>{t(lang, "El caso", "Case study")} →</a>}
                      {(p.extra ?? (p.sitio ? [{ label: t(lang, "Sitio", "Site"), href: p.sitio }] : [])).map((l) => (
                        <a href={l.href} target="_blank" rel="noopener">
                          {l.label} ↗
                        </a>
                      ))}
                    </p>
                  </div>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <section id="sj-stack" class="sj-sec">
        <p class="sj-k">{n(4)} · Stack</p>
        <h2>{t(lang, "Cancha de bochas", "The bocce field")}</h2>
        <p class="sj-p sj-nota">
          {t(
            lang,
            "En el valle hay piedras redondas que parecen bochas. Acá son las tecnologías que uso.",
            "The valley has round stones that look like bocce balls. Here they're the technologies I use.",
          )}
          <span class="sj-solo-vivo">
            {t(lang, " Arrastralas o soplá el Zonda.", " Drag them or blow the Zonda.")}
            <button type="button" class="sj-mini" data-zonda-2>{t(lang, "Soplar", "Blow")}</button>
          </span>
        </p>
        <div class="sj-caja" data-caja>
          {
            habilidades.map((h) => (
              <span class={`sj-chip sj-${h.area}`} style={`--d:${diam(h.nombre)}px`} data-chip>
                <span>{h.nombre}</span>
              </span>
            ))
          }
        </div>
        <p class="sj-p sj-est">
          {estudios[0].titulo} · {estudios[0].institucion}. {t(lang, "Inglés avanzado (exámenes internacionales).", "Advanced English (international exams).")}
        </p>
      </section>

      <section id="sj-contacto" class="sj-sec sj-contacto">
        <div>
          <p class="sj-k">{n(5)} · {t(lang, "Contacto", "Contact")}</p>
          <h2>{t(lang, "¿Arrancamos algo?", "Shall we start something?")}</h2>
          <p class="sj-p">
            <a href={`mailto:${perfil.email}`}>{perfil.email}</a> ·{" "}
            <a href={perfil.linkedin} target="_blank" rel="noopener">LinkedIn</a> ·{" "}
            <a href={perfil.github} target="_blank" rel="noopener">GitHub</a>
          </p>
        </div>
        <MensajeForm />
      </section>

      <footer class="sj-pie">
        <p>
          {t(
            lang,
            "Hecho en San Juan con Astro y matter-js. Ischigualasto es real; este, dibujado. El Zonda también es real; este, simulado.",
            "Made in San Juan with Astro and matter-js. Ischigualasto is real; this one is drawn. The Zonda is real too; this one is simulated.",
          )}
        </p>
      </footer>
    </main>
  </div>
</ViewLayout>

<script>
  import "@/scripts/zonda";
  // el botón chico de la cancha usa el mismo Zonda
  document.querySelector("[data-zonda-2]")?.addEventListener("click", () => {
    document.querySelector<HTMLButtonElement>("[data-zonda]")?.click();
  });
</script>

<style is:global>
  body:has(.sj) {
    margin: 0;
    background: #120f1c;
    overflow-x: clip;
  }
  .sj {
    --noche: #0f1428;
    --noche-2: #1a1d36;
    --tierra: #2a1a1c;
    --tierra-2: #1c1418;
    --arcilla: #d8cdb8;
    --rojo: #b7643f;
    --ocre: #e7a65a;
    --luna: #f4ecd6;
    --arena: #f3eadb;
    --arena-2: #f3eadbad;
    --viento: 0;
    --ix-ink: var(--arena);
    --ix-ink-2: var(--arena-2);
    --ix-accent: var(--ocre);
    --ix-bg: var(--tierra-2);
    --ix-font: "Bricolage Grotesque", system-ui, sans-serif;
    --mf-bg: #ffffff0d;
    --mf-ink: var(--arena);
    --mf-ink-2: var(--arena-2);
    --mf-line: #f3eadb33;
    --mf-accent: var(--ocre);
    --mf-accent-ink: var(--tierra-2);
    --mf-radius: 12px;
    position: relative;
    color: var(--arena);
    font-family: "Bricolage Grotesque", system-ui, sans-serif;
    font-size: 17px;
    line-height: 1.55;
  }
  .sj *,
  .sj *::before,
  .sj *::after {
    box-sizing: border-box;
  }
  .sj :where(h1, h2, h3, p, ol, figure) {
    margin: 0;
  }
  .sj a {
    color: inherit;
    text-decoration-color: color-mix(in srgb, var(--ocre) 60%, transparent);
    text-underline-offset: 3px;
  }
  .sj a:hover {
    color: var(--ocre);
  }
  .sj :focus-visible {
    outline: 2px solid var(--ocre);
    outline-offset: 3px;
  }
  .sj-polvo {
    position: fixed;
    inset: 0;
    z-index: 40;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .sj-k {
    font: 500 12px/1.4 "IBM Plex Mono", ui-monospace, monospace;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ocre);
  }

  /* ── Cielo nocturno y formaciones ────────────────────────── */
  .sj-hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }
  .sj-cielo {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 60% 40% at 50% 78%, #b76a4a66, transparent 70%),
      linear-gradient(180deg, #070a18 0%, var(--noche) 35%, #2b2443 62%, #6b3f45 80%, #8a5241 100%);
  }
  .sj-estrellas {
    position: absolute;
    inset: 0 0 auto;
    width: 100%;
    height: 70%;
    fill: #fffbe8;
    opacity: calc(1 - var(--viento) * 0.8);
  }
  .sj-estrellas circle {
    animation: sj-titila 3.5s ease-in-out infinite;
  }
  @keyframes sj-titila {
    50% {
      opacity: 0.35;
    }
  }
  .sj-luna {
    position: absolute;
    right: 14%;
    top: 12%;
    width: clamp(90px, 11vw, 170px);
    aspect-ratio: 1;
    border-radius: 50%;
    background:
      radial-gradient(circle at 34% 38%, #d9cfb4 0 9%, transparent 10%),
      radial-gradient(circle at 62% 60%, #ddd3b9 0 13%, transparent 14%),
      radial-gradient(circle at 58% 28%, #e2d9c0 0 6%, transparent 7%),
      radial-gradient(circle at 40% 40%, #fffaf0, var(--luna) 60%, #e6dcc2);
    box-shadow:
      0 0 60px 10px #f4ecd640,
      0 0 160px 40px #f4ecd61a;
    filter: blur(calc(var(--viento) * 3px));
    opacity: calc(1 - var(--viento) * 0.45);
  }
  .sj-capa,
  .sj-suelo,
  .sj-bochas {
    position: absolute;
    left: -2%;
    width: 104%;
  }
  .sj-capa {
    transform: translateX(calc(var(--viento) * -10px));
  }
  .sj-capa-3 {
    bottom: 20%;
    height: 30%;
    fill: #7a3a33;
  }
  .sj-capa-3 .sj-veta {
    fill: none;
    stroke: #5e2b29;
    stroke-width: 3;
  }
  .sj-capa-2 {
    bottom: 13%;
    height: 26%;
    fill: #8e8576;
  }
  .sj-forma {
    position: absolute;
    bottom: 15%;
    fill: #3d2b2c;
  }
  .sj-forma .sj-veta {
    fill: none;
    stroke: #2c1f21;
    stroke-width: 3;
  }
  .sj-submarino {
    left: 8%;
    height: 34%;
  }
  .sj-hongo {
    right: 10%;
    height: 30%;
  }
  .sj-hongo path + path {
    fill: none;
    stroke: #3d2b2c;
    stroke-width: 6;
  }
  .sj-suelo {
    bottom: 0;
    height: 22%;
    fill: #4a3a37;
  }
  .sj-bochas {
    bottom: 0;
    height: 22%;
    fill: #8f8577;
  }
  .sj-bochas circle {
    fill: #9b9183;
    stroke: #6f665a;
    stroke-width: 1.5;
  }
  .sj-bochas .sj-sombra {
    fill: #00000059;
    stroke: none;
  }
  .sj-bruma {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, #8a6a4a, #c98a5a);
    mix-blend-mode: soft-light;
    opacity: calc(var(--viento) * 1.1);
  }
  .sj-hero-in {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 96px 20px 26vh;
  }
  .sj h1 {
    margin-top: 12px;
    font-size: clamp(64px, 14vw, 196px);
    font-weight: 800;
    line-height: 0.84;
    letter-spacing: -0.05em;
    color: var(--luna);
    text-shadow: 0 0 40px #f4ecd626;
  }
  .sj-linea {
    display: block;
  }
  .sj-linea span {
    display: inline-block;
    will-change: transform;
  }
  .sj-linea + .sj-linea {
    color: var(--ocre);
  }
  .sj-bajada {
    max-width: 48ch;
    margin-top: 24px;
    font-size: clamp(17px, 1.6vw, 20px);
    color: var(--arena);
  }
  .sj-clima {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    margin-top: 22px;
    font: 500 13px/1.4 "IBM Plex Mono", ui-monospace, monospace;
    color: var(--arena-2);
    font-variant-numeric: tabular-nums;
  }
  .sj-clima b {
    color: var(--arena);
  }
  .sj-btn,
  .sj-mini {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 52px;
    margin-top: 20px;
    padding: 0 22px;
    font: inherit;
    font-weight: 700;
    color: var(--tierra-2);
    background: var(--luna);
    border: 0;
    border-radius: 999px;
    cursor: pointer;
    box-shadow: 0 0 32px #f4ecd640;
    transition: transform 0.2s;
  }
  .sj-btn:hover {
    transform: translateY(-2px);
  }
  .sj-btn[aria-pressed="true"] {
    background: var(--ocre);
  }
  .sj-btn[aria-pressed="true"] svg {
    animation: sj-sopla 0.6s ease-in-out infinite;
  }
  .sj-btn-off,
  .sj-btn[aria-pressed="true"] .sj-btn-on {
    display: none;
  }
  .sj-btn[aria-pressed="true"] .sj-btn-off {
    display: inline;
  }
  @keyframes sj-sopla {
    50% {
      transform: translateX(4px);
    }
  }
  .sj-mini {
    min-height: 40px;
