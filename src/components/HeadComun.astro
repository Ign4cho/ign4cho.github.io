---
// Metadatos comunes de todas las páginas: canonical, versiones por idioma,
// Open Graph con la imagen de cada vista (public/og/<vista>.png, se generan con
// `npm run og`) y transiciones animadas entre vistas (View Transitions entre
// documentos: no hace falta el router de Astro).
//
// En la vista de inicio, además, `?vista=dashboard` lleva directo a esa vista y,
// si alguien vuelve al sitio desde afuera, se abre la última vista que eligió.
import { perfil, vistas } from "@/data/perfil";
import { otraRuta, type Lang } from "@/data/i18n";

interface Props {
  title: string;
  description: string;
  vista: string;
  lang: Lang;
  /** Imagen OG propia (relativa a public/); por defecto og/<vista>.png */
  og?: string;
}

const { title, description, vista, lang, og } = Astro.props;
const base = import.meta.env.BASE_URL;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const alterna = new URL(otraRuta(Astro.url.pathname, lang), Astro.site).href;
const ogImage = new URL(`${base}${og ?? `og/${vista}.png`}`, Astro.site).href;
const esInicio = vista === "bento";
const rutas = Object.fromEntries(vistas.map((v) => [v.id, v.href]));
const prefijo = `${base}${lang === "en" ? "en/" : ""}`;
---

<link rel="canonical" href={canonical} />
<link rel="alternate" hreflang={lang} href={canonical} />
<link rel="alternate" hreflang={lang === "es" ? "en" : "es"} href={alterna} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content="website" />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content={lang === "es" ? "es_AR" : "en_US"} />
<meta property="og:site_name" content={`Portfolio de ${perfil.nombre}`} />
<meta name="twitter:card" content="summary_large_image" />

{
  esInicio && (
    <script is:inline define:vars={{ rutas, prefijo }}>
      (() => {
        const ir = (id) => {
          if (id && id !== "bento" && id in rutas) {
            location.replace(prefijo + rutas[id] + location.hash);
            return true;
          }
          return false;
        };
        const q = new URLSearchParams(location.search).get("vista");
        if (q) {
          try { localStorage.setItem("pf-vista", q); } catch {}
          if (ir(q)) return;
        }
        // Solo al llegar desde afuera: navegar dentro del sitio hasta acá no redirige.
        let interno = false;
        try { interno = !!document.referrer && new URL(document.referrer).origin === location.origin; } catch {}
        if (interno) return;
        try { ir(localStorage.getItem("pf-vista")); } catch {}
      })();
    </script>
  )
}

<style is:global>
  @view-transition {
    navigation: auto;
  }
  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation-duration: 0.45s;
    animation-timing-function: cubic-bezier(0.32, 0.72, 0, 1);
  }
  ::view-transition-old(root) {
    animation-name: pf-salida;
  }
  ::view-transition-new(root) {
    animation-name: pf-entrada;
  }
  @keyframes pf-salida {
    to {
      opacity: 0;
      transform: scale(0.97);
      filter: blur(6px);
    }
  }
  @keyframes pf-entrada {
    from {
      opacity: 0;
      transform: translateY(24px) scale(1.01);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    ::view-transition-group(*),
    ::view-transition-old(*),
    ::view-transition-new(*) {
      animation: none !important;
    }
  }
</style>
