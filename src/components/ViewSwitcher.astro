---
// Selector de vista: mismo contenido, distinto diseño. Fijo arriba a la derecha
// en mobile y abajo a la derecha en desktop (arriba está el nav de la clásica).
// Toma los colores y la tipografía de la vista actual (`data-tema`), cambia de
// idioma y abre la paleta Ctrl+K para saltar a cualquier vista o proyecto.
// La vista elegida acá o en la paleta se recuerda (ver ViewLayout, «pf-vista»).
import { contenido, ruta, otraRuta, t, type Lang } from "@/data/i18n";
import { casos } from "@/data/casos";

interface Props {
  actual: string;
  lang?: Lang;
  /** Tema del selector cuando la página no es una vista (casos de estudio). */
  tema?: string;
}

const { actual, lang = "es", tema = actual } = Astro.props;
const { vistas, proyectos, perfil } = contenido(lang);
const nombreActual = vistas.find((v) => v.id === actual)?.nombre ?? t(lang, "Caso de estudio", "Case study");
const otroLang: Lang = lang === "es" ? "en" : "es";
const idiomaHref = otraRuta(Astro.url.pathname, lang);

const items = [
  ...vistas.map((v, i) => ({
    tipo: t(lang, "Vista", "View"),
    titulo: v.nombre,
    detalle: v.detalle,
    href: ruta(lang, v.href),
    vista: v.id,
    n: String(i + 1).padStart(2, "0"),
  })),
  ...proyectos
    .filter((p) => casos.some((c) => c.id === p.id))
    .map((p) => ({
      tipo: t(lang, "Proyecto", "Project"),
      titulo: p.titulo,
      detalle: t(lang, "Caso de estudio: problema, decisiones y resultado", "Case study: problem, decisions and outcome"),
      href: ruta(lang, `casos/${p.id}/`),
      vista: "",
      n: "→",
    })),
  { tipo: t(lang, "Idioma", "Language"), titulo: lang === "es" ? "English version" : "Versión en español", detalle: "", href: idiomaHref, vista: "", n: otroLang.toUpperCase() },
  { tipo: "Link", titulo: "GitHub", detalle: perfil.github.replace("https://", ""), href: perfil.github, vista: "", n: "↗" },
  { tipo: "Link", titulo: "LinkedIn", detalle: perfil.linkedin.replace("https://www.", ""), href: perfil.linkedin, vista: "", n: "↗" },
  { tipo: "Email", titulo: perfil.email, detalle: t(lang, "Escribirme", "Write to me"), href: `mailto:${perfil.email}`, vista: "", n: "@" },
];
---

<div class="vs-wrap" data-tema={tema}>
  <details class="vs" data-view-switcher>
    <summary aria-label={t(lang, `Cambiar de vista. Vista actual: ${nombreActual}`, `Change view. Current view: ${nombreActual}`)}>
      <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
        <path d="M3 3h8v8H3V3Zm2 2v4h4V5H5Zm8-2h8v8h-8V3Zm2 2v4h4V5h-4ZM3 13h8v8H3v-8Zm2 2v4h4v-4H5Zm8-2h8v8h-8v-8Zm2 2v4h4v-4h-4Z"></path>
      </svg>
      <span>{t(lang, "Vista", "View")}: {nombreActual}</span>
    </summary>
    <div class="vs-menu">
      <ul>
        {
          vistas.map((v, i) => (
            <li>
              <a href={ruta(lang, v.href)} data-vista={v.id} aria-current={v.id === actual ? "page" : undefined}>
                <span class="vs-n">{String(i + 1).padStart(2, "0")}</span>
                <span>
                  <strong>{v.nombre}</strong>
                  <small>{v.detalle}</small>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
      <div class="vs-pie">
        <a href={idiomaHref} hreflang={otroLang} lang={otroLang}>{lang === "es" ? "English" : "Español"}</a>
        <button type="button" data-abrir-paleta>
          {t(lang, "Buscar", "Search")} <kbd>Ctrl K</kbd>
        </button>
      </div>
    </div>
  </details>

  <dialog class="pk" data-paleta aria-label={t(lang, "Ir a una vista o proyecto", "Go to a view or project")}>
    <div class="pk-box">
      <label class="pk-q">
        <span class="pk-sr">{t(lang, "Buscar", "Search")}</span>
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="m21 21-4.3-4.3M11 18a7 7 0 1 1 0-14 7 7 0 0 1 0 14Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
        <input type="search" placeholder={t(lang, "Vista, proyecto o link…", "View, project or link…")} autocomplete="off" spellcheck="false" data-pk-input aria-controls="pk-lista" />
        <kbd>Esc</kbd>
      </label>
      <ul id="pk-lista" role="listbox" data-pk-lista>
        {
          items.map((it) => (
            <li role="option" aria-selected="false">
              <a
                href={it.href}
                data-vista={it.vista || undefined}
                data-buscar={`${it.tipo} ${it.titulo} ${it.detalle}`}
                target={it.href.startsWith("http") ? "_blank" : undefined}
                rel={it.href.startsWith("http") ? "noopener" : undefined}
                aria-current={it.vista && it.vista === actual ? "page" : undefined}
              >
                <span class="pk-n">{it.n}</span>
                <span class="pk-t">
                  <strong>{it.titulo}</strong>
                  {it.detalle && <small>{it.detalle}</small>}
                </span>
                <span class="pk-tipo">{it.tipo}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="pk-vacio" data-pk-vacio hidden>{t(lang, "Nada con ese nombre.", "Nothing by that name.")}</p>
    </div>
  </dialog>
</div>

<style>
  /* ── Temas: uno por vista ─────────────────────────────────── */
  .vs-wrap {
    --vs-bg: #161616;
    --vs-ink: #f4f4f2;
    --vs-ink-2: #f4f4f2a6;
    --vs-line: #ffffff26;
    --vs-hover: #ffffff12;
    --vs-cur: #ffffff1c;
    --vs-accent: #a476ff;
    --vs-font: "Montserrat Variable", system-ui, sans-serif;
    --vs-mono: ui-monospace, Consolas, monospace;
    --vs-r: 999px;
    --vs-r-menu: 16px;
    --vs-shadow: 0 6px 20px #0000003d;
    --vs-blur: none;
  }
  .vs-wrap[data-tema="bento"] {
    --vs-bg: #151519;
    --vs-ink: #f2f2ee;
    --vs-ink-2: #f2f2eea3;
    --vs-line: #ffffff1f;
    --vs-accent: #a9ff5b;
    --vs-font: "Space Grotesk", system-ui, sans-serif;
    --vs-r-menu: 20px;
  }
  .vs-wrap[data-tema="linaje"] {
    --vs-bg: #ffffff;
    --vs-ink: #1c2033;
    --vs-ink-2: #555a6e;
    --vs-line: #dcdde3;
    --vs-hover: #1c20330d;
    --vs-cur: #ff694b1f;
    --vs-accent: #c2410c;
    --vs-font: system-ui, -apple-system, "Segoe UI", sans-serif;
    --vs-r: 8px;
    --vs-r-menu: 10px;
    --vs-shadow: 0 6px 20px #1c203326;
  }
  .vs-wrap[data-tema="dashboard"] {
    --vs-bg: #fcfcfb;
    --vs-ink: #1b1b19;
    --vs-ink-2: #52514e;
    --vs-line: #d9d8d3;
    --vs-hover: #2a78d60f;
    --vs-cur: #2a78d61f;
    --vs-accent: #2a78d6;
    --vs-font: "Segoe UI", system-ui, -apple-system, sans-serif;
    --vs-r: 2px;
    --vs-r-menu: 2px;
    --vs-shadow: 0 2px 8px #0000002e;
  }
  @media (prefers-color-scheme: dark) {
    .vs-wrap[data-tema="linaje"] {
      --vs-bg: #1b1e27;
      --vs-ink: #eceef4;
      --vs-ink-2: #a3a8b8;
      --vs-line: #2c303c;
      --vs-hover: #ffffff0d;
      --vs-accent: #ff694b;
    }
    .vs-wrap[data-tema="dashboard"] {
      --vs-bg: #1a1a19;
      --vs-ink: #f0efec;
      --vs-ink-2: #c3c2b7;
      --vs-line: #2f2f2c;
      --vs-hover: #ffffff0d;
      --vs-accent: #5b9ae6;
    }
  }
  .vs-wrap[data-tema="terminal"] {
    --vs-bg: #121720;
    --vs-ink: #d8dee9;
    --vs-ink-2: #8a93a6;
    --vs-line: #232a36;
    --vs-hover: #7ee78714;
    --vs-cur: #7ee78724;
    --vs-accent: #7ee787;
    --vs-font: ui-monospace, "Cascadia Code", Consolas, monospace;
    --vs-r: 0;
    --vs-r-menu: 0;
  }
  .vs-wrap[data-tema="pliego"] {
    --vs-bg: #201d1bd9;
    --vs-ink: #efe7d6;
    --vs-ink-2: #efe7d6a3;
    --vs-line: #efe7d629;
    --vs-hover: #ff6f521a;
    --vs-cur: #ff6f522e;
    --vs-accent: #ff6f52;
    --vs-font: "Courier Prime", "Courier New", monospace;
    --vs-blur: blur(8px);
  }
  .vs-wrap[data-tema="mesa"] {
    --vs-bg: #f6efe0;
    --vs-ink: #2d2a29;
    --vs-ink-2: #2d2a29a8;
    --vs-line: #2d2a2926;
    --vs-hover: #2d2a290d;
    --vs-cur: #c93a1924;
    --vs-accent: #c93a19;
    --vs-font: "Outfit", system-ui, sans-serif;
    --vs-r: 4px;
    --vs-r-menu: 4px;
    --vs-shadow: 0 10px 24px #0000004d;
  }
  .vs-wrap[data-tema="editorial"] {
    --vs-bg: #fbfaf7;
    --vs-ink: #141414;
    --vs-ink-2: #5a5a57;
    --vs-line: #14141426;
    --vs-hover: #1414140a;
    --vs-cur: #b3261e14;
    --vs-accent: #b3261e;
    --vs-font: "Newsreader", Georgia, serif;
    --vs-r: 0;
    --vs-r-menu: 0;
    --vs-shadow: 0 4px 16px #1414141f;
  }
  .vs-wrap[data-tema="sanjuan"] {
    --vs-bg: #1a1d36e6;
    --vs-ink: #f3eadb;
    --vs-ink-2: #f3eadba8;
    --vs-line: #f3eadb2e;
    --vs-hover: #e7a65a1c;
    --vs-cur: #e7a65a2e;
    --vs-accent: #e7a65a;
    --vs-font: "Bricolage Grotesque", system-ui, sans-serif;
    --vs-r-menu: 18px;
    --vs-blur: blur(10px);
  }

  /* ── Selector ─────────────────────────────────────────────── */
  .vs {
    position: fixed;
    z-index: 1000;
    right: 16px;
    top: 16px;
    font-family: var(--vs-font);
    font-size: 14px;
    color: var(--vs-ink);
    view-transition-name: selector-vista;
  }
  @media (min-width: 768px) {
    .vs {
      top: auto;
      bottom: 24px;
      right: 24px;
    }
  }
  .vs summary {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 16px;
    border-radius: var(--vs-r);
    background: var(--vs-bg);
    border: 1px solid var(--vs-line);
    box-shadow: var(--vs-shadow);
    backdrop-filter: var(--vs-blur);
    cursor: pointer;
    user-select: none;
  }
  .vs summary svg {
    color: var(--vs-accent);
  }
  .vs summary::-webkit-details-marker {
    display: none;
  }
  .vs summary:focus-visible,
  .vs a:focus-visible,
  .vs button:focus-visible,
  .pk a:focus-visible {
    outline: 2px solid var(--vs-accent);
    outline-offset: 2px;
  }
  .vs-menu {
    position: absolute;
    right: 0;
    top: calc(100% + 8px);
    width: min(320px, calc(100vw - 32px));
    padding: 6px;
    border-radius: var(--vs-r-menu);
    background: var(--vs-bg);
    border: 1px solid var(--vs-line);
    box-shadow: var(--vs-shadow), 0 12px 32px #00000040;
    backdrop-filter: var(--vs-blur);
  }
  @media (min-width: 768px) {
    .vs-menu {
      top: auto;
      bottom: calc(100% + 8px);
    }
  }
  .vs ul {
    list-style: none;
    margin: 0;
    padding: 0;
    max-height: min(60vh, 540px);
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .vs a {
    display: flex;
    gap: 12px;
    align-items: baseline;
    padding: 9px 12px;
    border-radius: calc(var(--vs-r-menu) * 0.6);
    color: inherit;
    text-decoration: none;
  }
  .vs a:hover {
    background: var(--vs-hover);
  }
  .vs a[aria-current="page"] {
    background: var(--vs-cur);
  }
  .vs-n {
    font-family: var(--vs-mono);
    font-size: 12px;
    color: var(--vs-accent);
  }
  .vs strong {
    display: block;
    font-weight: 600;
  }
  .vs small {
    display: block;
    margin-top: 2px;
    font-size: 12px;
    color: var(--vs-ink-2);
  }
  .vs-pie {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    margin-top: 6px;
    padding: 6px 2px 0;
    border-top: 1px solid var(--vs-line);
  }
  .vs-pie a,
  .vs-pie button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 40px;
    padding: 0 10px;
    font: inherit;
    font-size: 13px;
    color: inherit;
    background: none;
    border: 0;
    border-radius: calc(var(--vs-r-menu) * 0.6);
    cursor: pointer;
  }
  .vs-pie a:hover,
  .vs-pie button:hover {
    background: var(--vs-hover);
  }
  kbd {
    font-family: var(--vs-mono);
    font-size: 11px;
    padding: 2px 6px;
    border: 1px solid var(--vs-line);
    border-radius: 4px;
    color: var(--vs-ink-2);
  }

  /* ── Paleta Ctrl+K ────────────────────────────────────────── */
  .pk {
    width: min(560px, calc(100vw - 32px));
    max-height: min(70vh, 620px);
    margin: 12vh auto auto;
    padding: 0;
    border: 1px solid var(--vs-line);
    border-radius: var(--vs-r-menu);
    background: var(--vs-bg);
    color: var(--vs-ink);
    font-family: var(--vs-font);
    font-size: 15px;
    box-shadow: 0 24px 64px #00000059;
    backdrop-filter: var(--vs-blur);
  }
  .pk::backdrop {
    background: #0000008c;
    backdrop-filter: blur(3px);
  }
  .pk-box {
    display: flex;
    flex-direction: column;
    max-height: min(70vh, 620px);
  }
  .pk-q {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 4px 14px;
    border-bottom: 1px solid var(--vs-line);
    color: var(--vs-ink-2);
  }
  .pk-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
  .pk-q input {
    flex: 1;
    min-width: 0;
    min-height: 52px;
    border: 0;
    outline: 0;
    background: none;
    color: var(--vs-ink);
    font: inherit;
    font-size: 16px;
  }
  .pk ul {
    list-style: none;
    margin: 0;
    padding: 6px;
    overflow-y: auto;
  }
  .pk a {
    display: grid;
    grid-template-columns: 34px 1fr auto;
    gap: 10px;
    align-items: center;
    padding: 9px 10px;
    border-radius: calc(var(--vs-r-menu) * 0.6);
    color: inherit;
    text-decoration: none;
  }
  .pk li[aria-selected="true"] a {
    background: var(--vs-cur);
  }
  .pk a:hover {
    background: var(--vs-hover);
  }
  .pk-n {
    font-family: var(--vs-mono);
    font-size: 12px;
    color: var(--vs-accent);
    text-align: center;
  }
  .pk-t strong {
    display: block;
    font-weight: 600;
    overflow-wrap: anywhere;
  }
  .pk-t small {
    display: block;
    font-size: 12px;
    color: var(--vs-ink-2);
  }
  .pk-tipo {
    font-family: var(--vs-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--vs-ink-2);
  }
  .pk-vacio {
    margin: 0;
    padding: 20px;
    color: var(--vs-ink-2);
  }
  @media (max-width: 520px) {
    .pk-tipo {
      display: none;
    }
    .pk a {
      grid-template-columns: 30px 1fr;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .pk[open] {
      animation: pk-in 0.18s ease-out;
    }
  }
  @keyframes pk-in {
    from {
      opacity: 0;
      transform: translateY(-8px) scale(0.98);
    }
  }
</style>

<script>
  const GUARDAR = "pf-vista";
  const recordar = (vista?: string) => {
    if (!vista) return;
    try {
      localStorage.setItem(GUARDAR, vista);
    } catch {
      /* sin storage: no se recuerda */
    }
  };

  // Cerrar al hacer clic afuera o con Escape.
  const vs = document.querySelector<HTMLDetailsElement>("[data-view-switcher]");
  if (vs) {
    document.addEventListener("click", (e) => {
      if (vs.open && !vs.contains(e.target as Node)) vs.open = false;
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && vs.open) {
        vs.open = false;
        vs.querySelector("summary")?.focus();
      }
    });
  }
  document.querySelectorAll<HTMLAnchorElement>("[data-vista]").forEach((a) => a.addEventListener("click", () => recordar(a.dataset.vista)));

  // ── Paleta Ctrl+K ─────────────────────────────────────────
  const pk = document.querySelector<HTMLDialogElement>("[data-paleta]");
  const input = pk?.querySelector<HTMLInputElement>("[data-pk-input]");
  const opciones = [...(pk?.querySelectorAll<HTMLLIElement>("[data-pk-lista] li") ?? [])];
  const vacio = pk?.querySelector<HTMLElement>("[data-pk-vacio]");
  const norm = (s: string) => s.normalize("NFD").replace(/[̀-ͯ]/g, "").toLowerCase();
  let sel = 0;

  const visibles = () => opciones.filter((li) => !li.hidden);
  function marcar(i: number) {
    const v = visibles();
    if (!v.length) return;
    sel = (i + v.length) % v.length;
    v.forEach((li, j) => li.setAttribute("aria-selected", String(j === sel)));
    v[sel].scrollIntoView({ block: "nearest" });
  }
  function filtrar() {
    const q = norm(input?.value ?? "").trim().split(/\s+/).filter(Boolean);
    opciones.forEach((li) => {
      const txt = norm(li.querySelector("a")?.dataset.buscar ?? "");
      li.hidden = !q.every((w) => txt.includes(w));
      li.setAttribute("aria-selected", "false");
    });
    if (vacio) vacio.hidden = visibles().length > 0;
    marcar(0);
  }
  function abrir() {
    if (!pk || pk.open) return;
    if (vs) vs.open = false;
    pk.showModal();
    if (input) input.value = "";
    filtrar();
    input?.focus();
  }
  document.addEventListener("keydown", (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === "k") {
      e.preventDefault();
      if (pk?.open) pk.close();
      else abrir();
    }
  });
  document.querySelector("[data-abrir-paleta]")?.addEventListener("click", abrir);
  input?.addEventListener("input", filtrar);
  input?.addEventListener("keydown", (e) => {
    if (e.key === "ArrowDown" || e.key === "ArrowUp") {
      e.preventDefault();
      marcar(sel + (e.key === "ArrowDown" ? 1 : -1));
    } else if (e.key === "Enter") {
      const a = visibles()[sel]?.querySelector("a");
      if (a) {
        e.preventDefault();
        a.click();
      }
    }
  });
  pk?.addEventListener("click", (e) => {
    if (e.target === pk) pk.close();
  });
  opciones.forEach((li) => li.querySelector("a")?.addEventListener("click", () => pk?.close()));
</script>
