---
import { experiencia, periodo } from "@/data/perfil";

const jobs = experiencia
  .filter((e) => e.destacada)
  .map((e) => ({ company: e.empresa, role: e.rol, date: periodo(e.desde, e.hasta), description: e.descripcion, tags: e.tags }));
---

<section
  id="experience"
  class="py-12 border-t border-[#ffffff10] text-[var(--white)]"
>
  <div class="max-w-5xl mx-auto">
    <h2 class="text-lg text-[var(--sec)] mb-2 shiny-sec">Dónde trabajé</h2>
    <h3 class="text-4xl md:text-5xl font-medium mb-8">Experiencia</h3>

    <ol class="space-y-4">
      {
        jobs.map((job) => (
          <li class="grid md:grid-cols-[220px_1fr] gap-2 md:gap-8 p-5 md:p-6 rounded-2xl bg-[#1414149c] border border-[var(--white-icon-tr)]">
            <div>
              <p class="text-xl font-semibold">{job.company}</p>
              <p class="text-sm text-[var(--white-icon)] mt-1">{job.date}</p>
            </div>
            <div>
              <p class="text-lg">{job.role}</p>
              <p class="text-sm text-[var(--white-icon)] mt-1">{job.description}</p>
              <ul class="flex flex-wrap gap-2 mt-3">
                {job.tags.map((tag) => (
                  <li class="text-xs px-3 py-1 rounded-full border border-[var(--white-icon-tr)] text-[var(--white-icon)]">
                    {tag}
                  </li>
                ))}
              </ul>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
