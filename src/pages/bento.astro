---
// Vista «Bento»: todo el portfolio en una grilla de bloques de distintos
// tamaños, para leerlo de un vistazo. Contenido de perfil.ts.
import ViewLayout from "@/layouts/ViewLayout.astro";
import MensajeForm from "@/components/MensajeForm.astro";
import { perfil, experiencia, proyectos, habilidades, estudios, vistas, AREAS, meses, periodo } from "@/data/perfil";

const base = import.meta.env.BASE_URL;
const proj = (id: string) => proyectos.find((p) => p.id === id)!;
const datyo = experiencia.find((e) => e.id === "datyo")!;
const mesesDatyo = meses(datyo.desde, datyo.hasta);
const trayectoria = experiencia.map((e) => ({ ...e, m: meses(e.desde, e.hasta) }));
const maxM = Math.max(...trayectoria.map((e) => e.m));
const stack = (["datos", "web", "qa"] as const).map((a) => ({ area: AREAS[a], items: habilidades.filter((h) => h.area === a) }));
const otrasVistas = vistas.filter((v) => v.id !== "bento");
const tarjetas = [
  { p: proj("tesis_sube"), clase: "b-tesis" },
  { p: proj("tienda_online"), clase: "b-elargot" },
  { p: proj("experimentos_amine"), clase: "b-exp" },
  { p: proj("espacioamine"), clase: "b-amine" },
];
---

<ViewLayout
  title="Ignacio Colomé · Bento"
  description="El portfolio de Ignacio Colomé en una grilla: datos, web, proyectos y experiencia de un vistazo."
  vista="bento"
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&display=swap" rel="stylesheet" />
  </Fragment>

  <main class="bt">
    <div class="bt-grid">
      <section class="bt-c b-intro">
        <p class="bt-badge"><i></i>{perfil.disponibilidad}</p>
        <div>
          <p class="bt-hola">Hola, soy {perfil.nombre}</p>
          <h1>Datos <span>y</span> Web</h1>
          <p class="bt-bajada">
            Analista de datos en Datyo: modelo warehouses con dbt y armo tableros en Power BI. También diseño y desarrollo
            sitios web con foco en la interacción.
          </p>
        </div>
        <nav class="bt-links" aria-label="Redes">
          <a href={perfil.github} target="_blank" rel="noopener">GitHub ↗</a>
          <a href={perfil.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a>
          <a href={`mailto:${perfil.email}`}>Email ↗</a>
        </nav>
      </section>

      <figure class="bt-c b-foto">
        <img src={`${base}foto_perfil_recorte.jpg`} alt={perfil.nombre} loading="eager" />
      </figure>

      <section class="bt-c b-ahora">
        <p class="bt-k">Ahora</p>
        <p class="bt-num">{mesesDatyo}<small>{mesesDatyo === 1 ? "mes" : "meses"}</small></p>
        <p class="bt-t">{datyo.rol} en {datyo.empresa}</p>
        <p class="bt-s">{datyo.tags.join(" · ")}</p>
      </section>

      <section class="bt-c b-stats">
        <p class="bt-k">En números</p>
        <dl>
          <div><dt>Tecnologías</dt><dd>{habilidades.length}</dd></div>
          <div><dt>Proyectos</dt><dd>{proyectos.length}</dd></div>
          <div><dt>Desde</dt><dd>{perfil.inicio}</dd></div>
        </dl>
      </section>

      {
        tarjetas.map(({ p, clase }) => (
          <article class={`bt-c bt-proj ${clase}`}>
            {p.imagen && <img src={`${base}${p.imagen}`} alt="" loading="lazy" />}
            <div class="bt-proj-body">
              <p class="bt-k">{p.estado} · {AREAS[p.area]}</p>
              <h2>{p.titulo}</h2>
              <p class="bt-s bt-desc">{p.descripcion}</p>
              <div class="bt-chips">
                {(p.extra ?? (p.sitio ? [{ label: "Sitio", href: p.sitio }] : [])).map((l) => (
                  <a href={l.href} target="_blank" rel="noopener">{l.label} ↗</a>
                ))}
                {p.codigo && <a href={p.codigo} target="_blank" rel="noopener">Código ↗</a>}
              </div>
            </div>
          </article>
        ))
      }

      <section class="bt-c b-sj">
        <svg class="bt-andes" viewBox="0 0 300 120" preserveAspectRatio="none" aria-hidden="true">
          <path d="M0 120 L0 78 L28 52 L46 66 L74 30 L96 58 L120 40 L146 70 L170 22 L196 60 L220 46 L246 74 L270 48 L300 70 L300 120 Z" />
          <path class="bt-andes-2" d="M0 120 L0 96 L40 76 L70 90 L104 68 L140 92 L182 74 L214 94 L252 80 L300 98 L300 120 Z" />
        </svg>
        <p class="bt-k">Base</p>
        <p class="bt-t">{perfil.ubicacion}</p>
        <p class="bt-s mono">31°32′S · 68°31′O</p>
        <p class="bt-hora mono" data-hora aria-live="off">--:--</p>
      </section>

      <section class="bt-c b-tray">
        <p class="bt-k">Trayectoria</p>
        <ol>
          {
            trayectoria.map((e) => (
              <li>
                <div class="bt-tray-top">
                  <strong>{e.empresa}</strong>
                  <span class="mono">{periodo(e.desde, e.hasta)}</span>
                </div>
                <p class="bt-s">{e.rol}</p>
                <span class={`bt-bar bt-${e.area}`} style={`--w:${Math.max(6, (e.m / maxM) * 100)}%`} title={`${e.m} meses`} />
              </li>
            ))
          }
        </ol>
      </section>

      <section class="bt-c b-stack">
        <p class="bt-k">Stack</p>
        {
          stack.map((g) => (
            <div class="bt-stack-g">
              <span class="bt-s">{g.area}</span>
              <ul class="bt-chips">
                {g.items.map((h) => <li>{h.nombre}</li>)}
              </ul>
            </div>
          ))
        }
      </section>

      <section class="bt-c b-est">
        <p class="bt-k">Formación</p>
        <ul>
          <li><strong>{estudios[0].titulo}</strong><span class="bt-s">{estudios[0].institucion}</span></li>
          <li><strong>Inglés avanzado</strong><span class="bt-s">Exámenes internacionales 2017 y 2018</span></li>
        </ul>
      </section>

      <section class="bt-c b-contacto" aria-labelledby="bt-contacto-t">
        <div>
          <p class="bt-k">¿Hablamos?</p>
          <h2 id="bt-contacto-t" class="bt-contacto-t">¿Tenés un proyecto en mente? Escribime.</h2>
          <a class="bt-mail" href={`mailto:${perfil.email}`}>{perfil.email} ↗</a>
        </div>
        <MensajeForm />
      </section>

      <nav class="bt-c b-vistas" aria-label="Otras vistas">
        <p class="bt-k">Otras vistas</p>
        <ul>
          {otrasVistas.map((v) => <li><a href={`${base}${v.href}`}>{v.nombre} <span aria-hidden="true">→</span></a></li>)}
        </ul>
      </nav>
    </div>
  </main>
</ViewLayout>

<script>
  // Hora local de San Juan, en vivo.
  const hora = document.querySelector("[data-hora]");
  if (hora) {
    const fmt = new Intl.DateTimeFormat("es-AR", { hour: "2-digit", minute: "2-digit", hourCycle: "h23", timeZone: "America/Argentina/San_Juan" });
    const tick = () => (hora.textContent = `${fmt.format(new Date())} hs`);
    tick();
    setInterval(tick, 15000);
  }
  // Luz que sigue al mouse en cada bloque.
  document.addEventListener("pointermove", (e) => {
    const el = e.target instanceof Element ? e.target.closest<HTMLElement>(".bt-c") : null;
    if (!el) return;
    const r = el.getBoundingClientRect();
    el.style.setProperty("--mx", `${e.clientX - r.left}px`);
    el.style.setProperty("--my", `${e.clientY - r.top}px`);
  });
</script>

<style is:global>
  body:has(.bt) {
    margin: 0;
    background: #0b0b0d;
  }
  .bt {
    --bg: #0b0b0d;
    --cell: #151519;
    --cell-2: #1c1c22;
    --line: #ffffff14;
    --ink: #f2f2ee;
    --ink-2: #f2f2eea3;
    --lima: #a9ff5b;
    --lila: #a476ff;
    --naranja: #ff8a4c;
    min-height: 100vh;
    padding: 76px 16px 16px; /* arriba queda el selector de vista en mobile */
    color: var(--ink);
    font-family: "Space Grotesk", system-ui, sans-serif;
    font-size: 15px;
    line-height: 1.45;
  }
  .bt .mono {
    font-family: ui-monospace, Consolas, monospace;
    font-size: 12px;
  }
  .bt a {
    color: inherit;
  }
  .bt :focus-visible {
    outline: 2px solid var(--lima);
    outline-offset: 2px;
  }
  .bt-grid {
    display: grid;
    gap: 12px;
    max-width: 1280px;
    margin: 0 auto;
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) {
    .bt {
      padding: 24px;
    }
    .bt-grid {
      grid-template-columns: repeat(2, 1fr);
      grid-auto-flow: dense;
    }
    .b-intro,
    .b-tray,
    .b-tesis,
    .b-elargot,
    .b-stack,
    .b-contacto {
      grid-column: span 2;
    }
  }
  @media (min-width: 1024px) {
    .bt-grid {
      grid-template-columns: repeat(4, 1fr);
      grid-auto-rows: minmax(170px, auto);
    }
    .b-intro {
      grid-column: span 2;
      grid-row: span 2;
    }
    .b-foto {
      grid-row: span 2;
    }
    .b-tesis,
    .b-elargot {
      grid-column: span 2;
      grid-row: span 2;
    }
    .b-exp {
      grid-column: span 2;
    }
    .b-tray {
      grid-column: span 2;
      grid-row: span 2;
    }
    .b-contacto {
      grid-column: span 4;
    }
  }

  /* Bloque base */
  .bt-c {
    position: relative;
    overflow: hidden;
    margin: 0;
    padding: 22px;
    border-radius: 24px;
    background: var(--cell);
    border: 1px solid var(--line);
    transition:
      transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1),
      border-color 0.35s;
    animation: bt-in 0.6s cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }
  .bt-c::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.3s;
    background: radial-gradient(380px circle at var(--mx, 50%) var(--my, 50%), #a9ff5b14, transparent 60%);
  }
  .bt-c:hover {
    border-color: #ffffff2e;
  }
  .bt-c:hover::after {
    opacity: 1;
  }
  .bt-grid > :nth-child(2) { animation-delay: 0.05s; }
  .bt-grid > :nth-child(3) { animation-delay: 0.1s; }
  .bt-grid > :nth-child(4) { animation-delay: 0.15s; }
  .bt-grid > :nth-child(5) { animation-delay: 0.2s; }
  .bt-grid > :nth-child(6) { animation-delay: 0.25s; }
  .bt-grid > :nth-child(n + 7) { animation-delay: 0.3s; }
  @keyframes bt-in {
    from {
      opacity: 0;
      transform: translateY(14px) scale(0.98);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .bt-c {
      animation: none;
      transition: none;
    }
  }

  .bt-k {
    margin: 0 0 8px;
    font-family: ui-monospace, Consolas, monospace;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-2);
  }
  .bt-t {
    margin: 0;
    font-size: 18px;
    font-weight: 500;
  }
  .bt-s {
    margin: 0;
    font-size: 13px;
    color: var(--ink-2);
  }
  .bt-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 12px 0 0;
    padding: 0;
    list-style: none;
  }
  .bt-chips > * {
    padding: 4px 10px;
    border-radius: 999px;
    border: 1px solid var(--line);
    font-size: 12px;
    text-decoration: none;
    background: #ffffff08;
  }
  .bt-chips a:hover {
    background: var(--lima);
    border-color: var(--lima);
    color: #0b0b0d;
  }

  /* Intro */
  .b-intro {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 28px;
    background:
      radial-gradient(120% 90% at 100% 0%, #a476ff2e, transparent 60%),
      radial-gradient(90% 80% at 0% 100%, #a9ff5b14, transparent 60%),
      var(--cell);
  }
  .bt-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    align-self: flex-start;
    margin: 0;
    padding: 5px 12px;
    border-radius: 999px;
    border: 1px solid var(--line);
    font-size: 13px;
    color: var(--ink-2);
  }
  .bt-badge i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--lima);
    box-shadow: 0 0 0 0 #a9ff5b80;
    animation: bt-pulse 2s infinite;
  }
  @keyframes bt-pulse {
    70% {
      box-shadow: 0 0 0 8px #a9ff5b00;
    }
  }
  .bt-hola {
    margin: 0 0 6px;
    color: var(--ink-2);
  }
  .b-intro h1 {
    margin: 0;
    font-size: clamp(56px, 8vw, 104px);
    line-height: 0.88;
    letter-spacing: -0.04em;
    font-weight: 700;
  }
  .b-intro h1 span {
    font-weight: 400;
    color: var(--lila);
  }
  .bt-bajada {
    max-width: 46ch;
    margin: 16px 0 0;
    color: var(--ink-2);
  }
  .bt-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .bt-links a {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    padding: 0 16px;
    border-radius: 999px;
    background: var(--ink);
    color: #0b0b0d;
    font-weight: 500;
    text-decoration: none;
  }
  .bt-links a:hover {
    background: var(--lima);
  }

  /* Foto */
  .b-foto {
    padding: 0;
    min-height: 320px;
  }
  .b-foto img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.25);
    transition:
      filter 0.4s,
      transform 0.6s;
  }
  .b-foto:hover img {
    filter: none;
    transform: scale(1.04);
  }

  /* Ahora / números */
  .b-ahora {
    background: var(--lima);
    color: #0b0b0d;
    border-color: transparent;
  }
  .b-ahora .bt-k,
  .b-ahora .bt-s {
    color: #0b0b0dad;
  }
  .bt-num {
    margin: 0;
    font-size: 64px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.04em;
  }
  .bt-num small {
    margin-left: 6px;
    font-size: 18px;
    font-weight: 500;
    letter-spacing: 0;
  }
  .b-stats dl {
    display: grid;
    gap: 8px;
    margin: 0;
  }
  .b-stats dl div {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--line);
  }
  .b-stats dt {
    color: var(--ink-2);
    font-size: 13px;
  }
  .b-stats dd {
    margin: 0;
    font-size: 28px;
    font-weight: 700;
  }

  /* Proyectos */
  .bt-proj {
    display: flex;
    flex-direction: column;
    padding: 0;
    min-height: 260px;
  }
  .bt-proj img {
    width: 100%;
    height: 200px;
    object-fit: cover;
    object-position: top;
    background: #fff;
    transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .bt-proj:hover img {
    transform: scale(1.03);
  }
  .b-tesis img,
  .b-elargot img {
    height: 240px;
  }
  .b-tesis img {
    object-fit: contain;
  }
  .bt-proj-body {
    padding: 18px 22px 22px;
  }
  .bt-proj h2 {
    margin: 0;
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.2;
  }
  .bt-desc {
    margin-top: 8px;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .b-tesis .bt-desc,
  .b-elargot .bt-desc {
    -webkit-line-clamp: 4;
  }

  /* San Juan */
  .b-sj {
    background: linear-gradient(#1d1622, #2a1a1a);
    min-height: 200px;
  }
  .bt-andes {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 55%;
    fill: #ff8a4c33;
  }
  .bt-andes-2 {
    fill: #7a3b4a66;
  }
  .bt-hora {
    position: relative;
    margin: 18px 0 0;
    font-size: 26px !important;
    color: var(--naranja);
  }

  /* Trayectoria */
  .b-tray ol {
    display: grid;
    gap: 14px;
    margin: 4px 0 0;
    padding: 0;
    list-style: none;
  }
  .bt-tray-top {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    align-items: baseline;
  }
  .bt-tray-top span {
    color: var(--ink-2);
    white-space: nowrap;
  }
  .bt-bar {
    display: block;
    height: 6px;
    margin-top: 6px;
    width: var(--w);
    border-radius: 999px;
    background: var(--lila);
  }
  .bt-bar.bt-datos {
    background: var(--lima);
  }
  .bt-bar.bt-qa {
    background: var(--naranja);
  }
  .bt-bar.bt-soporte {
    background: #8a8a94;
  }

  /* Stack */
  .bt-stack-g + .bt-stack-g {
    margin-top: 12px;
  }
  .bt-stack-g .bt-chips {
    margin-top: 6px;
  }

  /* Formación */
  .b-est ul {
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .b-est li {
    display: grid;
    gap: 2px;
  }

  /* Contacto */
  .b-contacto {
    display: grid;
    gap: 20px;
    align-items: start;
    background: var(--lila);
    color: #0b0b0d;
    border-color: transparent;
    --mf-bg: #ffffff59;
    --mf-ink: #0b0b0d;
    --mf-ink-2: #0b0b0dc0;
    --mf-line: #0b0b0d26;
    --mf-accent: #0b0b0d;
    --mf-accent-ink: #f2f2ee;
    --mf-radius: 14px;
  }
  @media (min-width: 1024px) {
    .b-contacto {
      grid-template-columns: 1fr 1.2fr;
      gap: 40px;
    }
  }
  .b-contacto .bt-k {
    color: #0b0b0dad;
  }
  .bt-contacto-t {
    margin: 0 0 12px;
    font-size: clamp(26px, 3.4vw, 44px);
    line-height: 1.05;
    letter-spacing: -0.03em;
    font-weight: 700;
  }
  .bt-mail {
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 3px;
    word-break: break-all;
  }

  /* Otras vistas */
  .b-vistas ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .b-vistas a {
    display: flex;
    justify-content: space-between;
    min-height: 40px;
    align-items: center;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
  }
  .b-vistas a:hover {
    color: var(--lima);
  }
</style>
